<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Dependency-injection integration for ApricotFramework.ObjectStore: stores bound from configuration with environment-variable overrides, startup validation of every store against the registered providers, keyed and default store resolution, and the registration seam for definitions held in a database or a secrets store. Depends only on Microsoft.Extensions.*, so a worker or console host can use it.</Description>
    <PackageTags>objectstore;storage;dependencyinjection;configuration;options</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.ObjectStore/ApricotFramework.ObjectStore.csproj" />
  </ItemGroup>

</Project>
