{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ObjectStore": {
    // The store a lookup uses when it names none. Also what an unkeyed IObjectStore resolves to.
    "DefaultStore": "uploads",

    "Stores": {
      // Kept in memory, so the example runs with nothing external. Presigned URLs are not available
      // here: there is no server to honour them.
      "uploads": {
        "Provider": "memory"
      },
      "avatars": {
        "Provider": "memory"
      }

      // A real S3-compatible server, for presigned URLs. Keep the keys out of this file and set them in
      // the environment, or in user secrets:
      //   ObjectStore__Stores__minio__Settings__AccessKeyId
      //   ObjectStore__Stores__minio__Settings__SecretAccessKey
      // Without them the store falls back to the AWS default credential chain.
      // "minio": {
      //   "Provider": "s3",
      //   "Settings": {
      //     "Bucket": "example",
      //     "Prefix": "demo",
      //     "ServiceUrl": "http://localhost:9000",
      //     // The address browsers reach the server on, when it differs from the one this service uses.
      //     "PublicServiceUrl": "http://localhost:9000",
      //     "MaxPresignedExpiry": "00:30:00"
      //   }
      // },
      //
      // Real AWS needs only a bucket and a region, and takes its credentials from the role it runs as.
      // "prod-like": {
      //   "Provider": "s3",
      //   "Settings": { "Bucket": "my-bucket", "Region": "eu-west-1" }
      // }
    }
  }
}
